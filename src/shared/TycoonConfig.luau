    id: string,
    name: string,
    color: Color3,
    secondaryColor: Color3,
    abilityName: string,
    abilityDesc: string,
    dropperItemName: string,
    oreColor: Color3,
    baseAbility: AbilityInfo,
    tacticalAbility: AbilityInfo,
    ultimateAbility: AbilityInfo,
    specialAbility: AbilityInfo,
